# ADB
ro.adb.secure=0

# Crypto
fbe.metadata.wrappedkey=true
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.metadata.enabled=true
ro.crypto.support_metadata_encrypt=true
ro.crypto.uses_fs_ioc_add_encryption_key=true
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.volume.metadata.method=dm-default-key

# Deviceinfo
ro.build.product=RMX3366
ro.commonsoft.ota=RE546F
ro.product.brand=realme
ro.product.device=RE546F
ro.product.manufacturer=realme
ro.product.model=RMX3366
ro.product.name=RMX3366
ro.product.product.brand=realme
ro.product.product.device=RE546F
ro.product.product.manufacturer=realme
ro.product.product.model=RMX3366
ro.product.product.name=RMX3366
ro.separate.soft=21615

# Dynamic partitions
ro.boot.dynamic_partitions=true

# Gatekeeper
vendor.gatekeeper.disable_spu=true

# USB
persist.sys.isUsbOtgEnabled=true
